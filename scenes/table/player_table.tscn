[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/table/player_table.gd" id="1_script"]
[ext_resource type="Script" path="res://ui/drop_zone.gd" id="2_drop_zone"]

[sub_resource type="StyleBoxFlat" id="panel_bg"]
bg_color = Color(0.06, 0.06, 0.1, 1)
border_width_left = 2
border_width_right = 2
border_width_top = 2
border_width_bottom = 2
border_color = Color(0.15, 0.15, 0.25, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="PlayerTable" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="TableBG" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("panel_bg")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
