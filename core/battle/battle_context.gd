# Phase 27H-R0: Encounter 配置权威的 phase lock 快照（fallback 保留旧常量）
var _boss_phase_locks: Dictionary = {
	2: {"phase": 2, "hp_threshold": 51, "shield_gain": 4},
	3: {"phase": 3, "hp_threshold": 25, "shield_gain": 6},
}

func configure_encounter_rules(encounter: Dictionary) -> void:
	phase_locks_enabled = encounter.get("phase_locks_enabled", true) == true
	var parsed: Dictionary = {}
	for raw in encounter.get("phase_locks", []):
		if not raw is Dictionary:
			continue
		var phase: int = int(raw.get("phase", 0))
		if phase not in [2, 3]:
			continue
		parsed[phase] = {
			"phase": phase,
			"hp_threshold": int(raw.get("hp_threshold", 0)),
			"shield_gain": int(raw.get("shield_gain", 0)),
		}
	if parsed.has(2) and parsed.has(3):
		_boss_phase_locks = parsed.duplicate(true)
		print("[BATTLE CONTEXT] Phase locks configured from encounter: phase2=%s phase3=%s" % [str(parsed.get(2)), str(parsed.get(3))])

func get_boss_phase_lock(phase: int) -> Dictionary:
	var value: Dictionary = _boss_phase_locks.get(phase, {})
	return value.duplicate(true)

