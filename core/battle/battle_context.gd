# OD Depth / Abyss Pressure — Phase 3B-1

# =========================



## 手动修改 Depth — 映射至新 depth_pressure。正向达到 6 触发 Backlash，负向降到 6 以下清除 Backlash。

func modify_depth(delta: int, source: String = "") -> void:
	var old_depth := depth_pressure
	var was_locked := is_abyss_locked()
	depth_pressure = clampi(depth_pressure + delta, 0, get_depth_max_value())
	turn_depth = depth_pressure
	max_turn_depth = maxi(max_turn_depth, depth_pressure)

	var triggered := false
	if depth_pressure >= get_depth_max_value() and old_depth < get_depth_max_value() and not was_locked:
		_set_backlash_active(true, source)
		abyss_shock_triggered = true
		triggered = true
	elif delta < 0 and depth_pressure < get_depth_max_value() and was_locked:
		_set_backlash_active(false, source)

	if source != "":
		print("[DEPTH] %s: Depth %+d -> %d [%s]" % [source, delta, depth_pressure, get_depth_zone()])

	if triggered:
		abyss_shock_triggered_signal.emit(get_depth_max_value())
	depth_changed.emit(depth_pressure, get_depth_zone())
	if depth_pressure < old_depth:
		depth_reduced.emit(old_depth - depth_pressure, source, depth_pressure)





## 准备抵消后续 Depth 增加。建筑/控制牌可调用。

func prepare_depth_reduction(amount: int, source: String = "") -> void:

	if amount <= 0:

		return

	pending_depth_reduction += amount

	if source != "":

		pending_depth_reduction_source = source

	print("[DEPTH] Prepared reduction %+d from %s (pending=%d)" % [amount, source, pending_depth_reduction])





## 增加 Depth（由 OD 增量驱动）— 映射至新 depth_pressure

func add_depth(amount: int, source: String = "") -> void:

	add_depth_pressure(amount, source)





# -----------------------------------

# Phase 7A-4: 新 Depth Pressure API

# -----------------------------------



## 增加 Depth Pressure（新主入口）。达到 6 时触发单回合 Backlash，不清零。

func add_depth_pressure(amount: int, source: String = "", defer_signal: bool = false) -> Array[Dictionary]:
	var notifications: Array[Dictionary] = []
	if amount <= 0:
		return notifications
	if pending_depth_reduction > 0:
		var reduced := mini(amount, pending_depth_reduction)
		var final_amount := amount - reduced
		var reduce_source := pending_depth_reduction_source if pending_depth_reduction_source != "" else "Depth Guard"
		pending_depth_reduction -= reduced
		if pending_depth_reduction <= 0:
			pending_depth_reduction = 0
			pending_depth_reduction_source = ""
		_record_depth_notification(notifications, {"kind": &"mitigated", "source": reduce_source, "reduced": reduced, "amount": final_amount}, defer_signal)
		amount = final_amount
		if amount <= 0:
			return notifications

	var old_depth := depth_pressure
	depth_pressure = mini(depth_pressure + amount, get_depth_max_value())
	turn_depth = depth_pressure
	max_turn_depth = maxi(max_turn_depth, depth_pressure)
	if depth_pressure >= get_depth_max_value() and old_depth < get_depth_max_value():
		notifications.append_array(trigger_abyss_backlash(source, defer_signal))
	else:
		_record_depth_notification(notifications, {"kind": &"depth", "depth": depth_pressure, "zone": get_depth_zone()}, defer_signal)
	return notifications


## Data-only notification receipts; no queue, timer, or second Depth authority.
func _record_depth_notification(notifications: Array[Dictionary], event: Dictionary, defer_signal: bool) -> void:
	notifications.append(event.duplicate(true))
	if not defer_signal:
		publish_depth_notifications([event])


func publish_depth_notifications(notifications: Array[Dictionary]) -> void:
	for event: Dictionary in notifications:
		match event.get("kind", &""):
			&"mitigated":
				depth_gain_mitigated.emit(str(event.source), int(event.reduced), int(event.amount))
			&"abyss":
				abyss_shock_triggered_signal.emit(int(event.depth))
			&"depth":
				depth_changed.emit(int(event.depth), str(event.zone))





## Phase 7A-4: 根据 Engine 推进评估 Depth 增长（每次出牌后调用）

func evaluate_engine_depth_pressure(source: String = "") -> void:

	if not od_mode:

		return



	var eg := od_mode.turn_engine_gain

	var lg := od_mode.turn_layers_gained

	var layer := od_mode.engine_layer

	var gains: Array[String] = []



	# 阈值 1: turn_engine_gain >= 4

	if eg >= 4 and not depth_threshold_4_triggered:

		depth_threshold_4_triggered = true

		gains.append("EG4")



	# 阈值 2: turn_engine_gain >= 7

	if eg >= 7 and not depth_threshold_7_triggered:

		depth_threshold_7_triggered = true

		gains.append("EG7")



	# 阈值 3: 升 1 层

	if lg >= 1 and not depth_layer_gain_triggered:

		depth_layer_gain_triggered = true

		gains.append("LayerUp")



	# 阈值 4: 升 2+ 层

	if lg >= 2 and not depth_double_layer_triggered:

		depth_double_layer_triggered = true

		gains.append("DoubleLayer")



	for g in gains:

		var amt := 1

		if g == "LayerUp" and lg >= 2:

			amt = 1  # 首次升层 +1；二次升层由 DoubleLayer 额外 +1

		if g == "DoubleLayer":

			amt = 1  # 额外 +1

		add_depth_pressure(amt, "%s:%s" % [source, g])

		print("[DEPTH PRESSURE] %s triggered by %s -> Depth %d/%d" % [g, source, depth_pressure, get_depth_max_value()])



	# 进入 Layer 4（首次检测）

	if layer >= 4 and not _layer4_depth_given:

		_layer4_depth_given = true

		add_depth_pressure(1, "%s:L4Entry" % source)

		print("[DEPTH PRESSURE] Layer 4 entry -> Depth %d/%d" % [depth_pressure, get_depth_max_value()])



	# 进入 Layer 5 / Burst

	if layer >= 5 and not _layer5_depth_given:

		_layer5_depth_given = true

		add_depth_pressure(2, "%s:L5Entry" % source)

		print("[DEPTH PRESSURE] Layer 5/Burst entry -> Depth %d/%d" % [depth_pressure, get_depth_max_value()])





## Phase 7A-4: 触发 Abyss Backlash — 深度保持 6，单回合锁定

func trigger_abyss_backlash(source: String = "", defer_signal: bool = false) -> Array[Dictionary]:
	var notifications: Array[Dictionary] = []
	depth_pressure = get_depth_max_value()
	turn_depth = depth_pressure
	max_turn_depth = maxi(max_turn_depth, depth_pressure)
	if is_abyss_locked():
		_record_depth_notification(notifications, {"kind": &"depth", "depth": depth_pressure, "zone": get_depth_zone()}, defer_signal)
		return notifications
	_set_backlash_active(true, source)
	abyss_shock_triggered = true
	_record_depth_notification(notifications, {"kind": &"abyss", "depth": get_depth_max_value()}, defer_signal)
	_record_depth_notification(notifications, {"kind": &"depth", "depth": depth_pressure, "zone": get_depth_zone()}, defer_signal)
	print("[ABYSS BACKLASH] Triggered by %s for current player turn; Depth remains %d/%d." % [
		source, depth_pressure, get_depth_max_value()
	])
	return notifications





## 回合结束 Depth 释放：固定 -2，清除 Backlash

func settle_depth_end_turn() -> Dictionary:
	var old_depth := depth_pressure
	depth_pressure = maxi(0, depth_pressure - get_depth_end_turn_recover())
	turn_depth = depth_pressure
	var lock_cleared := _set_backlash_active(false, "Turn Vent")
	abyss_shock_triggered = false
	if depth_pressure != old_depth or lock_cleared:
		depth_changed.emit(depth_pressure, get_depth_zone())
	if depth_pressure < old_depth:
		depth_reduced.emit(old_depth - depth_pressure, "Turn Vent", depth_pressure)
	return {
		"before": old_depth,
		"after": depth_pressure,
		"recovered": old_depth - depth_pressure,
		"backlash_cleared": lock_cleared,
	}


## 回合开始重置 Depth

func reset_turn_depth() -> void:
	# Depth 仅在回合末通过 settle_depth_end_turn() 释放，此处不再次衰减
	turn_depth = depth_pressure
	max_turn_depth = maxi(max_turn_depth, depth_pressure)
	abyss_shock_triggered = false
	_set_backlash_active(false, "turn_start_guard")
	# 重置阈值 flag
	depth_threshold_4_triggered = false
	depth_threshold_7_triggered = false
	depth_layer_gain_triggered = false
	depth_double_layer_triggered = false
	backlash_reduced_this_turn = false
	# Phase 15C: reset active effect tracking
	monster_active_used_ids.clear()
	depth_changed.emit(depth_pressure, get_depth_zone())




## 集中化 Backlash 状态写入器。业务代码不得直接修改 backlash_turns_remaining 或 abyss_locked。

func _set_backlash_active(active: bool, source: String = "") -> bool:
	var was_active := backlash_turns_remaining > 0 or abyss_locked
	backlash_turns_remaining = 1 if active else 0
	abyss_locked = active
	if was_active != active:
		print("[BACKLASH_STATE] %s -> %s source=%s" % [was_active, active, source])
	return was_active != active


## 返回当前 Depth 区间名称

func get_depth_zone() -> String:
	if is_abyss_locked():
		return "Backlash"
	if depth_pressure >= 4:
		return "Warning"
	return "Stable"

func is_abyss_locked() -> bool:
	return backlash_turns_remaining > 0


## Final card publication is separate from numeric/card identity mutation.
func publish_card_notifications(notifications: Array[Dictionary]) -> void:
	var pending := notifications.duplicate(true)
	notifications.clear()
	for event: Dictionary in pending:
		if event.get("kind") == &"awakening":
			if player != null:
				player.awakening_triggered.emit()
		elif chain_system != null:
			chain_system.publish_route_notifications([event])

