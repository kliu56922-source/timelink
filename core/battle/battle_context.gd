func _make_stable_combat_od_result(source: StringName, requested: int, reason: String = "") -> Dictionary:
	var od_value: int = od_mode.current_od if od_mode != null else 0
	return {
		"awarded": false,
		"source": source,
		"requested": requested,
		"applied": 0,
		"od_before": od_value,
		"od_after": od_value,
		"depth_before": depth_pressure,
		"depth_after": depth_pressure,
		"reason": reason,
	}


func _apply_stable_combat_od(source: StringName, requested: int, player_turn_reward: bool) -> Dictionary:
	var result := _make_stable_combat_od_result(source, requested)
	if requested <= 0 or od_mode == null:
		result["reason"] = "disabled"
		return result

	var allowed: int = requested
	if player_turn_reward:
		var remaining: int = maxi(0, _rule_snapshot.stable_od_player_turn_cap - _stable_combat_od_player_turn_total)
		if remaining <= 0:
			result["reason"] = "turn_cap"
			return result
		allowed = mini(allowed, remaining)

	if od_mode.current_od >= od_mode.max_value:
		result["reason"] = "od_full"
		return result

	# PHASE63_BEGIN_STABLE_CAP_RESERVE
	# Reserve before committed heat events can trigger another stable reward.
	if player_turn_reward:_stable_combat_od_player_turn_total+=allowed
	# PHASE63_END_STABLE_CAP_RESERVE
	var heat_before: int = od_mode.current_od
	_stable_combat_od_event_serial += 1
	var source_id := StringName("stable_combat:%s" % str(source))
	var transaction_id := StringName("stable:%s:turn:%d:%d" % [str(source), turn_count, _stable_combat_od_event_serial])
	var heat_result: Dictionary = add_heat(allowed, source_id, transaction_id, {
		"source_descriptor": get_heat_source_descriptor(&"stable_combat", source_id),
		"occurrence_id": source,
	})
	var applied: int = maxi(0, int(heat_result.get("applied", od_mode.current_od - heat_before)))
	result["applied"] = applied
	result["od_after"] = od_mode.current_od
	result["depth_after"] = depth_pressure
	result["transaction_id"] = transaction_id
	result["awarded"] = applied > 0
	if applied <= 0:
		# PHASE63_BEGIN_STABLE_CAP_RELEASE_EMPTY
		if player_turn_reward:_stable_combat_od_player_turn_total-=allowed
		# PHASE63_END_STABLE_CAP_RELEASE_EMPTY
		result["reason"] = "od_full"
		return result

	# PHASE63_BEGIN_STABLE_CAP_SETTLE
	if player_turn_reward:_stable_combat_od_player_turn_total-=allowed
	# PHASE63_END_STABLE_CAP_SETTLE
	if player_turn_reward:
		_stable_combat_od_player_turn_total += applied
	stable_combat_od_awarded.emit(result.duplicate(true))
	return result


func award_player_combat_stable_od(source: StringName) -> Dictionary:
	var requested: int = 0
	match source:
		&"unit_damage":
			requested = _rule_snapshot.stable_od_first_unit_damage
			if _stable_combat_od_unit_damage_consumed:
				return _make_stable_combat_od_result(source, requested, "duplicate")
			_stable_combat_od_unit_damage_consumed = true
		&"enemy_destroyed":
			requested = _rule_snapshot.stable_od_first_enemy_destroyed
			if _stable_combat_od_enemy_destroyed_consumed:
				return _make_stable_combat_od_result(source, requested, "duplicate")
			_stable_combat_od_enemy_destroyed_consumed = true
		_:
			return _make_stable_combat_od_result(source, 0, "disabled")
	return _apply_stable_combat_od(source, requested, true)


func award_boss_turn_core_damage_comeback(actual_hp_loss: int) -> Dictionary:
	var source := &"boss_core_damage_comeback"
	var requested: int = _rule_snapshot.stable_od_boss_turn_core_damage_comeback
	if (is_instance_valid(player) and player.hp <= 0) or (is_instance_valid(enemy) and enemy.hp <= 0):
		return _make_stable_combat_od_result(source, requested, "battle_ended")
	if actual_hp_loss <= 0:
		return _make_stable_combat_od_result(source, requested, "no_damage")
	if _stable_combat_od_boss_comeback_consumed:
		return _make_stable_combat_od_result(source, requested, "duplicate")
	_stable_combat_od_boss_comeback_consumed = true
	return _apply_stable_combat_od(source, requested, false)


func _ready():

