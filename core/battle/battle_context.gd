func enter_awakening(options: Dictionary = {}) -> Array[Dictionary]:
	if player == null or player.is_awakened:
		return []
	player.is_awakened = true
	var notifications: Array[Dictionary] = [{"kind": &"awakening"}]
	if not bool(options.get("defer_signal", false)):
		publish_card_notifications(notifications)
	print("[BattleContext] Entering Awakening!")
	return notifications



func exit_awakening():

	player.is_awakened = false

	print("[BattleContext] Exiting Awakening.")



