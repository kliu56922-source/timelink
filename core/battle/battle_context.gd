func on_card_played(card: CardData, options: Dictionary = {}) -> Array[Dictionary]:

	cards_played_this_turn += 1

	_record_card_identity(card)

	if chain_system:

		return chain_system.advance_route(card, options)
	return []





func _record_card_identity(card: CardData) -> void:

	if card == null:

		return

	if card.card_name != "" and not card.card_name in played_card_names:

		played_card_names.append(card.card_name)

	var series_to_count: Array[String] = []

	if card.series_id != "":

		series_to_count.append(card.series_id)

	for sid in card.secondary_series_ids:

		if sid is String and sid != "" and not sid in series_to_count:

			series_to_count.append(sid)

	for sid in series_to_count:

		series_played_counts[sid] = int(series_played_counts.get(sid, 0)) + 1





func get_series_played_count(series_id: String) -> int:

	if series_id == "":

		return 0

	return int(series_played_counts.get(series_id, 0))






