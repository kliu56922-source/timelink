func get_effect_repeat() -> int:

	var repeat: int = 1

	repeat += combo_system.get_repeat_bonus()

	if player.od_phase >= 2:

		repeat += 1

	if player.is_awakened and _awakening:

		repeat += _awakening.get_extra_repeat()

	return mini(repeat, 3)  # ADR-0003: 全局硬上限 effect_repeat ≤ 3



